    description='KBO 타자/투수 데이터 크롤링 및 Spark 처리 파이프라인',
    schedule_interval='0 2 * * *',
    catchup=False
) as dag:
    crawl_hitter_task = PythonOperator(
        task_id='crawl_hitter_task',
        python_callable=crawl_hitter_data, # 해당 함수 내에서 context["ti"].xcom_push(key="crawl_count", value=...) 필수
        provide_context=True,
    )

    crawl_pitcher_task = PythonOperator(
        task_id='crawl_pitcher_task',
