# [DAG 정의]
with DAG(
'kbo_player_etl_pipeline',
    default_args={
        'owner': 'kbo_admin',
        'depends_on_past': False,
        'start_date': datetime(2026, 7, 15),
        'retries': 0,
        'on_failure_callback': on_failure_alert
